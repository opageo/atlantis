    family-names: Lagaras
  - given-names: Ioannis
    family-names: Kalfas
repository-code: "https://github.com/opageo/atlantis"
license: Apache-2.0
version: 0.1.1
keywords:
  - floods
  - remote sensing
  - VIIRS
  - MODIS
  - GFM
  - Zarr
  - STAC
  - machine learning
